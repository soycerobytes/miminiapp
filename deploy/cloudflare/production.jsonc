{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "miminiapp",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false,
  },
}
