---
import BrandInitial from './BrandInitial.astro';
---

<svg
  class="hero-art"
  data-motion="hero"
  viewBox="-15 -12 540 490"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern
      id="laboratory-dots"
      width="18"
      height="18"
      patternUnits="userSpaceOnUse"
    >
      <circle cx="2" cy="2" r="1.6" fill="var(--color-brand)" opacity=".5" />
    </pattern>
  </defs>
  <g class="motion-entry" data-entry="dots">
    <g class="motion-ambient" data-ambient="dots">
      <rect
        x="44"
        y="42"
        width="190"
        height="154"
        fill="url(#laboratory-dots)"
      />
    </g>
  </g>
  <g class="motion-entry" data-entry="lime">
    <g class="motion-ambient" data-ambient="lime">
      <circle cx="346" cy="141" r="104" fill="var(--color-lime)" />
    </g>
  </g>
  <g class="motion-entry" data-entry="coral">
    <g class="motion-ambient" data-ambient="coral">
      <rect
        x="96"
        y="228"
        width="142"
        height="140"
        rx="24"
        fill="var(--color-coral)"
        transform="rotate(-15 167 298)"
      />
    </g>
  </g>
  <g class="motion-entry" data-entry="orbit">
    <g class="motion-ambient" data-ambient="orbit">
      <ellipse
        cx="268"
        cy="235"
        rx="223"
        ry="73"
        fill="none"
        stroke="var(--color-illustration-line)"
        stroke-width="2.3"
        transform="rotate(-24 268 235)"
      />
    </g>
  </g>
  <g class="motion-entry" data-entry="tile">
    <g class="motion-ambient" data-ambient="tile">
      <rect
        x="164"
        y="141"
        width="171"
        height="174"
        rx="30"
        fill="var(--color-hero-tile)"
        stroke="var(--color-hero-tile-border)"
        stroke-width="2"
        transform="rotate(-10 250 228)"
      />
      <g
        style="color: var(--color-hero-tile-brand)"
        transform="translate(205 146) rotate(-10 42 76) scale(1.2)"
      >
        <BrandInitial />
      </g>
    </g>
  </g>
  <g class="motion-entry" data-entry="rings">
    <g class="motion-ambient" data-ambient="rings">
      <circle
        cx="377"
        cy="310"
        r="38"
        fill="none"
        stroke="var(--color-illustration-line)"
        stroke-width="2"
      />
      <circle
        cx="405"
        cy="315"
        r="38"
        fill="none"
        stroke="var(--color-illustration-line)"
        stroke-width="2"
      />
    </g>
  </g>
  <g class="motion-entry" data-entry="satellite">
    <g class="motion-ambient" data-ambient="satellite">
      <circle cx="127" cy="326" r="13" fill="var(--color-brand)" />
    </g>
  </g>
  <g class="motion-entry" data-entry="wave">
    <g class="motion-ambient" data-ambient="wave">
      <path
        d="M183 392q18-33 36-1t36 0t36 0t36-1"
        stroke="var(--color-coral)"
        stroke-width="9"
        fill="none"
        stroke-linecap="round"
      />
    </g>
  </g>
</svg>
